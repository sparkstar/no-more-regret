---
# The rules the tool fixes without changing the behaviour.
Checks: >-
  -*,
  readability-implicit-bool-conversion,
  readability-braces-around-statements,
  misc-const-correctness,
  modernize-use-nullptr,
  modernize-use-override,
  readability-isolate-declaration,
  readability-math-missing-parentheses,
  readability-redundant-casting,
  readability-named-parameter,
  modernize-deprecated-headers,
  readability-else-after-return,
  readability-inconsistent-declaration-parameter-name,
  modernize-use-equals-default,
  modernize-use-using,
  readability-uppercase-literal-suffix,
  modernize-use-bool-literals,
  modernize-redundant-void-arg,
  readability-simplify-boolean-expr,
  readability-avoid-nested-conditional-operator,
  readability-identifier-naming,
  readability-make-member-function-const,
  google-explicit-constructor,
  modernize-use-nodiscard,
  google-readability-casting,
  misc-use-anonymous-namespace
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/port/(common|regret|remorse|system|platform|asylum|xan|compat)/.*'
CheckOptions:
  readability-implicit-bool-conversion.UseUpperCaseLiteralSuffix: true
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.GlobalConstantCase: UPPER_CASE
  readability-identifier-naming.ConstexprVariableCase: UPPER_CASE
  readability-identifier-naming.NamespaceCase: lower_case
  # The originals' names kept: ASYLUM.DLL's exports, the
  # display list's classes, Borland's and Phar Lap's library, and the fields
  # named by their place (unknown77_4: byte 77h, bit 4).
  readability-identifier-naming.FunctionIgnoredRegexp: '^(ASS_[A-Za-z]+|_fmem(cpy|set))$'
  readability-identifier-naming.ClassIgnoredRegexp: '^DL_[A-Za-z]+$'
  readability-identifier-naming.StructIgnoredRegexp: '^REGS_BINT$'
  readability-identifier-naming.EnumIgnoredRegexp: '^text_modes$'
  readability-identifier-naming.MemberIgnoredRegexp: '^(savedU|u)nknown[0-9a-f]+_[0-9]+$'
  # A private member may end in _, beside an accessor of its name.
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberIgnoredRegexp: '^([a-z][A-Za-z0-9]*_|(savedU|u)nknown[0-9a-f]+_[0-9]+)$'
